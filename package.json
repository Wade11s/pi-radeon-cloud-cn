{
  "name": "pi-radeon-cloud-cn",
  "version": "0.1.1",
  "description": "AMD Radeon Cloud CN provider extension for pi",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "amd",
    "radeon-cloud",
    "openai-compatible"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Wade11s/pi-radeon-cloud-cn#readme",
  "bugs": {
    "url": "https://github.com/Wade11s/pi-radeon-cloud-cn/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wade11s/pi-radeon-cloud-cn.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.ts",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-coding-agent": "1.0.4",
    "typescript": "^5.9.3"
  }
}
